#!/usr/bin/env ruby

ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

require 'bundler/setup'

# Lets lib files use plain `require 'pb_cli/...'` (no require_relative) --
# mirrors test/test_helper.rb, which does the same for the test suite.
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require_relative '../lib/pb_cli'

PbCli::CLI.start(ARGV)
